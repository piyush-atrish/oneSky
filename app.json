{
  "expo": {
    "name": "onesky",
    "slug": "onesky",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#474747",
          "image": "./assets/icon.png"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "oneSky uses your location to show the stars overhead right now. It is only used on your device to calculate the sky.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-status-bar"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0D17"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.piyushtest19steam.onesky",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b8394453-ee4d-481b-b638-4a4b94052837"
      }
    },
    "owner": "piyushtest19s-team"
  }
}